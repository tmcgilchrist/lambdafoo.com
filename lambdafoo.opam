# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "lambdafoo.com, a static site generated with YOCaml"
description:
  "The generator behind lambdafoo.com. Reads posts/, pages/, templates/ and the assets beside them, and writes a complete site into _site/."
maintainer: ["Tim McGilchrist <timmcgil@gmail.com>"]
authors: ["Tim McGilchrist <timmcgil@gmail.com>"]
license: "BSD-3-Clause"
homepage: "https://github.com/tmcgilchrist/lambdafoo.com"
bug-reports: "https://github.com/tmcgilchrist/lambdafoo.com/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.1.1"}
  "yocaml" {>= "3.0.0"}
  "yocaml_unix" {>= "3.0.0"}
  "yocaml_yaml" {>= "3.0.0"}
  "yocaml_jingoo" {>= "3.0.0"}
  "yocaml_markdown" {>= "3.0.0"}
  "yocaml_syndication" {>= "3.0.0"}
  "hilite" {>= "0.5.0"}
  "textmate-language"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tmcgilchrist/lambdafoo.com.git"
x-maintenance-intent: ["(latest)"]
